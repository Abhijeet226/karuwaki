# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=karuwakispeaks.com,www.karuwakispeaks.com,127.0.0.1,localhost

# Database Configuration (MySQL on server, or leave empty/set USE_SQLITE=1 for SQLite)
DB_ENGINE=django.db.backends.mysql
DB_NAME=Karuwaki_db
DB_USER=karuwaki
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=3306
USE_SQLITE=0

# Email SMTP Settings
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=user@example.com
EMAIL_HOST_PASSWORD=your-email-password

# Google reCAPTCHA
GOOGLE_RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Google Gemini AI API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_FALLBACK_API_KEY=your-gemini-fallback-api-key
